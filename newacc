                        "secondary": "#006970",
                        "surface-container-low": "#f3f4f5",
                        "on-primary": "#ffffff",
                        "on-tertiary-fixed": "#141d23",
                        "tertiary-fixed-dim": "#bfc8d0",
                        "surface-bright": "#f8f9fa",
                        "primary-fixed": "#d6e3ff",
                        "error": "#ba1a1a",
                        "surface-container": "#edeeef",
                        "tertiary-fixed": "#dbe4ed",
