                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "spacing": {
                        "unit": "4px",
                        "margin-mobile": "16px",
                        "margin-desktop": "40px",
                        "container-max": "1440px",
                        "gutter": "24px"
                    },
                    "fontFamily": {
                        "data-mono": ["Inter"],
                        "display-lg": ["Inter"],
                        "headline-md": ["Inter"],
