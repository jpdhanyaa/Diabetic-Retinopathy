<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Patient List Dashboard</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,400;0,700;1,400;1,700&amp;family=Public+Sans:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              "colors": {
                      "outline": "#727785",
                      "on-tertiary-container": "#000705",
                      "tertiary": "#006a5f",
                      "error-container": "#ffdad6",
                      "on-secondary": "#ffffff",
                      "on-secondary-fixed": "#1a1c1c",
                      "on-error-container": "#93000a",
                      "tertiary-container": "#008678",
                      "primary-fixed-dim": "#adc7ff",
                      "surface-tint": "#005bc0",
                      "background": "#fbf9f8",
                      "surface-container": "#f0eded",
                      "primary-container": "#1a73e8",
                      "tertiary-fixed-dim": "#70d8c8",
                      "surface-variant": "#e4e2e1",
                      "surface-container-low": "#f5f3f3",
                      "on-tertiary-fixed": "#00201c",
                      "secondary-fixed-dim": "#c6c6c7",
                      "inverse-surface": "#303030",
                      "secondary-container": "#dfe0e0",
                      "surface-bright": "#fbf9f8",
                      "inverse-primary": "#adc7ff",
                      "surface-dim": "#dcd9d9",
                      "on-error": "#ffffff",
                      "tertiary-fixed": "#8df5e4",
                      "secondary": "#5d5f5f",
                      "on-background": "#1b1c1c",
                      "on-secondary-container": "#616363",
                      "on-primary-fixed": "#001a41",
                      "surface-container-highest": "#e4e2e1",
                      "on-surface": "#1b1c1c",
                      "inverse-on-surface": "#f2f0f0",
                      "primary-fixed": "#d8e2ff",
                      "outline-variant": "#c1c6d6",
                      "on-primary-fixed-variant": "#004493",
                      "surface-container-high": "#eae8e7",
                      "on-surface-variant": "#414754",
                      "primary": "#005bbf",
                      "surface-container-lowest": "#ffffff",
                      "on-primary": "#ffffff",
                      "on-tertiary": "#ffffff",
                      "on-tertiary-fixed-variant": "#005048",
                      "surface": "#fbf9f8",
                      "on-secondary-fixed-variant": "#454747",
                      "error": "#ba1a1a",
                      "secondary-fixed": "#e2e2e2",
                      "on-primary-container": "#ffffff"
              },
              "borderRadius": {
                      "DEFAULT": "0.125rem",
                      "lg": "0.25rem",
                      "xl": "0.5rem",
                      "full": "0.75rem"
              },
              "spacing": {
                      "stack-sm": "8px",
                      "touch-target-min": "48px",
                      "stack-lg": "24px",
                      "stack-md": "16px",
                      "margin-mobile": "16px",
                      "gutter": "16px",
                      "margin-desktop": "32px",
                      "safe": "env(safe-area-inset-bottom, 16px)"
              },
              "fontFamily": {
                      "headline-md": [
                              "Public Sans"
                      ],
                      "body-md": [
                              "Atkinson Hyperlegible Next"
                      ],
                      "label-caps": [
                              "Atkinson Hyperlegible Next"
                      ],
                      "body-lg": [
                              "Atkinson Hyperlegible Next"
                      ],
                      "headline-lg": [
                              "Public Sans"
                      ],
                      "headline-lg-mobile": [
                              "Public Sans"
                      ],
                      "data-display": [
                              "Public Sans"
                      ]
              },
              "fontSize": {
                      "headline-md": [
                              "22px",
                              {
                                      "lineHeight": "28px",
                                      "fontWeight": "600"
                              }
                      ],
                      "body-md": [
                              "16px",
                              {
                                      "lineHeight": "24px",
                                      "fontWeight": "400"
                              }
                      ],
                      "label-caps": [
                              "12px",
                              {
                                      "lineHeight": "16px",
                                      "letterSpacing": "0.05em",
                                      "fontWeight": "700"
                              }
                      ],
                      "body-lg": [
                              "18px",
                              {
                                      "lineHeight": "26px",
                                      "fontWeight": "400"
                              }
                      ],
                      "headline-lg": [
                              "30px",
                              {
                                      "lineHeight": "38px",
                                      "letterSpacing": "-0.02em",
                                      "fontWeight": "700"
                              }
                      ],
                      "headline-lg-mobile": [
                              "24px",
                              {
                                      "lineHeight": "30px",
                                      "fontWeight": "700"
                              }
                      ],
                      "data-display": [
                              "36px",
                              {
                                      "lineHeight": "44px",
                                      "fontWeight": "700"
                              }
                      ]
              }
            }
          }
        }
      </script>
<style>
        .material-symbols-outlined {
          font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
      </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-surface text-on-surface antialiased pb-safe min-h-screen flex flex-col pt-[88px] md:pt-[104px] pb-[80px]">
<!-- Top App Bar Mock -->
<header class="fixed top-0 w-full z-50 bg-surface dark:bg-background border-b border-outline-variant dark:border-outline flat no shadows flex items-center justify-between px-margin-mobile h-touch-target-min max-w-7xl mx-auto py-stack-md bg-opacity-90 backdrop-blur-sm">
<div class="flex items-center gap-stack-sm">
<span class="material-symbols-outlined text-primary dark:text-primary-fixed-dim cursor-pointer" data-icon="menu">menu</span>
<h1 class="font-headline-md text-headline-md-mobile md:text-headline-md font-bold text-primary dark:text-primary-fixed-dim">Clinic Dashboard</h1>
</div>
<div class="flex items-center gap-stack-md">
<span class="material-symbols-outlined text-on-surface-variant cursor-pointer" data-icon="search">search</span>
<span class="material-symbols-outlined text-on-surface-variant cursor-pointer" data-icon="notifications">notifications</span>
<div class="w-8 h-8 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-body-md font-bold">
                HW
            </div>
</div>
</header>
<main class="flex-1 w-full max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop py-stack-lg flex flex-col gap-stack-lg">
<!-- Welcome Banner -->
<section class="bg-surface-container rounded-xl p-stack-md md:p-stack-lg flex flex-col md:flex-row items-start md:items-center justify-between border border-outline-variant">
<div>
<h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-stack-sm">Good morning, Dr. Vance.</h2>
<p class="font-body-md text-body-md text-on-surface-variant">You have <strong class="text-primary">12</strong> pending screenings today.</p>
</div>
<button class="mt-stack-md md:mt-0 bg-primary-container text-on-primary-container font-body-md font-bold py-3 px-6 rounded-lg min-h-touch-target-min flex items-center gap-stack-sm hover:bg-primary transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">add</span>
                Start New Screening
            </button>
</section>
<!-- Filters / Tabs -->
<div class="flex overflow-x-auto pb-stack-sm hide-scrollbar gap-stack-sm">
<button class="bg-primary-container text-on-primary-container font-label-caps text-label-caps py-2 px-4 rounded-full border border-primary-container min-h-touch-target-min whitespace-nowrap">
                All Patients (12)
            </button>
<button class="bg-surface text-on-surface-variant font-label-caps text-label-caps py-2 px-4 rounded-full border border-outline-variant hover:bg-surface-container min-h-touch-target-min whitespace-nowrap">
                High Risk (3)
            </button>
<button class="bg-surface text-on-surface-variant font-label-caps text-label-caps py-2 px-4 rounded-full border border-outline-variant hover:bg-surface-container min-h-touch-target-min whitespace-nowrap">
                Requires Follow-up (5)
            </button>
</div>
<!-- Patient List Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-stack-md md:gap-stack-lg">
<!-- Patient Card 1 (High Risk) -->
<article class="bg-surface-container-lowest border border-outline-variant rounded-xl p-stack-md flex flex-col gap-stack-md relative overflow-hidden group hover:border-primary transition-colors cursor-pointer" style="box-shadow: 0 4px 12px rgba(26, 115, 232, 0.05);">
<div class="absolute top-0 left-0 w-1 h-full bg-error"></div>
<div class="flex justify-between items-start">
<div>
<h3 class="font-headline-md text-headline-md-mobile text-on-surface">Maria Sanchez</h3>
<p class="font-body-md text-body-md text-on-surface-variant">Age: 64 • ID-8829</p>
</div>
<span class="bg-error-container text-on-error-container font-label-caps text-label-caps px-2 py-1 rounded-sm flex items-center gap-1">
<span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">warning</span>
                        HIGH RISK
                    </span>
</div>
<div class="grid grid-cols-2 gap-stack-sm bg-surface-container-low p-stack-sm rounded-lg border border-outline-variant">
<div>
<span class="font-label-caps text-label-caps text-on-surface-variant block mb-1">Blood Pressure</span>
<span class="font-data-display text-[24px] leading-tight font-bold text-error">158/95</span>
</div>
<div>
<span class="font-label-caps text-label-caps text-on-surface-variant block mb-1">Heart Rate</span>
<span class="font-data-display text-[24px] leading-tight font-bold text-on-surface">88</span>
</div>
</div>
<div class="flex items-center justify-between mt-auto pt-stack-sm border-t border-outline-variant">
<span class="font-body-md text-[14px] text-on-surface-variant flex items-center gap-1">
<span class="material-symbols-outlined text-[18px]">schedule</span>
                        Waiting: 45m
                    </span>
<button class="text-primary font-label-caps text-label-caps hover:underline p-2 min-h-[48px] flex items-center justify-center">View Vitals</button>
</div>
</article>
<!-- Patient Card 2 (Medium Risk) -->
<article class="bg-surface-container-lowest border border-outline-variant rounded-xl p-stack-md flex flex-col gap-stack-md relative overflow-hidden group hover:border-primary transition-colors cursor-pointer">
<div class="absolute top-0 left-0 w-1 h-full bg-[#fbbc04]"></div> <!-- Manual amber color for medium risk as not in theme -->
<div class="flex justify-between items-start">
<div>
<h3 class="font-headline-md text-headline-md-mobile text-on-surface">John Doe</h3>
<p class="font-body-md text-body-md text-on-surface-variant">Age: 52 • ID-1042</p>
</div>
<span class="bg-[#fef7e0] text-[#b06000] font-label-caps text-label-caps px-2 py-1 rounded-sm flex items-center gap-1">
<span class="material-symbols-outlined text-[16px]">info</span>
                        MONITOR
                    </span>
</div>
<div class="grid grid-cols-2 gap-stack-sm bg-surface-container-low p-stack-sm rounded-lg border border-outline-variant">
<div>
<span class="font-label-caps text-label-caps text-on-surface-variant block mb-1">Blood Pressure</span>
<span class="font-data-display text-[24px] leading-tight font-bold text-on-surface">135/85</span>
</div>
<div>
<span class="font-label-caps text-label-caps text-on-surface-variant block mb-1">Glucose</span>
<span class="font-data-display text-[24px] leading-tight font-bold text-[#b06000]">110 mg/dL</span>
</div>
</div>
<div class="flex items-center justify-between mt-auto pt-stack-sm border-t border-outline-variant">
<span class="font-body-md text-[14px] text-on-surface-variant flex items-center gap-1">
<span class="material-symbols-outlined text-[18px]">schedule</span>
                        Waiting: 12m
                    </span>
<button class="text-primary font-label-caps text-label-caps hover:underline p-2 min-h-[48px] flex items-center justify-center">View Vitals</button>
</div>
</article>
<!-- Patient Card 3 (Normal) -->
<article class="bg-surface-container-lowest border border-outline-variant rounded-xl p-stack-md flex flex-col gap-stack-md relative overflow-hidden group hover:border-primary transition-colors cursor-pointer">
<div class="absolute top-0 left-0 w-1 h-full bg-tertiary"></div>
<div class="flex justify-between items-start">
<div>
<h3 class="font-headline-md text-headline-md-mobile text-on-surface">Elena Rodriguez</h3>
<p class="font-body-md text-body-md text-on-surface-variant">Age: 28 • ID-9931</p>
</div>
<span class="bg-tertiary-fixed text-on-tertiary-fixed font-label-caps text-label-caps px-2 py-1 rounded-sm flex items-center gap-1">
<span class="material-symbols-outlined text-[16px]">check_circle</span>
                        NORMAL
                    </span>
</div>
<div class="grid grid-cols-2 gap-stack-sm bg-surface-container-low p-stack-sm rounded-lg border border-outline-variant">
<div>
<span class="font-label-caps text-label-caps text-on-surface-variant block mb-1">Blood Pressure</span>
<span class="font-data-display text-[24px] leading-tight font-bold text-on-surface">118/75</span>
</div>
<div>
<span class="font-label-caps text-label-caps text-on-surface-variant block mb-1">Heart Rate</span>
<span class="font-data-display text-[24px] leading-tight font-bold text-on-surface">65</span>
</div>
</div>
<div class="flex items-center justify-between mt-auto pt-stack-sm border-t border-outline-variant">
<span class="font-body-md text-[14px] text-on-surface-variant flex items-center gap-1">
<span class="material-symbols-outlined text-[18px]">schedule</span>
                        Scheduled: 10:00 AM
                    </span>
<button class="text-primary font-label-caps text-label-caps hover:underline p-2 min-h-[48px] flex items-center justify-center">View Vitals</button>
</div>
</article>
</div>
</main>
<!-- Floating Action Button (Mobile Only) -->
<button class="md:hidden fixed bottom-24 right-4 z-40 bg-primary-container text-on-primary-container p-4 rounded-full shadow-lg h-14 w-14 flex items-center justify-center hover:bg-primary transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 active:scale-95 duration-100">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">add</span>
</button>
<!-- Bottom Nav Bar from JSON -->
<nav class="md:hidden bg-surface dark:bg-background border-t border-outline-variant dark:border-outline flat no shadows fixed bottom-0 w-full z-50 h-16 fixed bottom-0 left-0 w-full flex justify-around items-center bg-surface dark:bg-background pb-safe">
<!-- Capture (Inactive) -->
<a class="flex flex-col items-center justify-center text-on-surface-variant dark:text-outline p-2 hover:text-primary dark:hover:text-primary-fixed-dim active:scale-90 transition-all duration-150 min-h-touch-target-min min-w-[48px]" href="#">
<span class="material-symbols-outlined" data-icon="photo_camera">photo_camera</span>
<span class="font-label-caps text-label-caps mt-1">Capture</span>
</a>
<!-- Patients (Active based on 'Patient list dashboard' prompt) -->
<a class="flex flex-col items-center justify-center bg-primary-container text-on-primary-container dark:bg-primary-fixed-dim dark:text-on-primary-fixed rounded-full px-4 py-1 hover:text-primary dark:hover:text-primary-fixed-dim active:scale-90 transition-all duration-150 min-h-touch-target-min min-w-[48px]" href="#">
<span class="material-symbols-outlined" data-icon="groups">groups</span>
<span class="font-label-caps text-label-caps mt-1 text-primary dark:text-primary-fixed-dim font-headline-md text-headline-md-mobile text-primary">Patients</span>
</a>
<!-- Results (Inactive) -->
<a class="flex flex-col items-center justify-center text-on-surface-variant dark:text-outline p-2 hover:text-primary dark:hover:text-primary-fixed-dim active:scale-90 transition-all duration-150 min-h-touch-target-min min-w-[48px]" href="#">
<span class="material-symbols-outlined" data-icon="analytics">analytics</span>
<span class="font-label-caps text-label-caps mt-1">Results</span>
</a>
<!-- Help (Inactive) -->
<a class="flex flex-col items-center justify-center text-on-surface-variant dark:text-outline p-2 hover:text-primary dark:hover:text-primary-fixed-dim active:scale-90 transition-all duration-150 min-h-touch-target-min min-w-[48px]" href="#">
<span class="material-symbols-outlined" data-icon="help">help</span>
<span class="font-label-caps text-label-caps mt-1">Help</span>
</a>
</nav>
<style>
        /* Hide scrollbar for horizontal filter list but keep functionality */
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;  /* IE and Edge */
            scrollbar-width: none;  /* Firefox */
        }
    </style>
</body></html>
