                        "secondary-fixed-dim": "#5dd8e2",
                        "outline-variant": "#c2c6d4",
                        "tertiary": "#404850",
                        "inverse-primary": "#a9c7ff",
                        "on-surface": "#191c1d",
                        "surface-container-lowest": "#ffffff",
                        "on-error": "#ffffff",
                        "inverse-surface": "#2e3132",
                        "on-primary-fixed": "#001b3d",
                        "inverse-on-surface": "#f0f1f2"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "spacing": {
                        "unit": "4px",
                        "margin-mobile": "16px",
                        "margin-desktop": "40px",
                        "container-max": "1440px",
                        "gutter": "24px"
                    },
                    "fontFamily": {
                        "data-mono": ["Inter"],
                        "display-lg": ["Inter"],
                        "headline-md": ["Inter"],
                        "body-lg": ["Inter"],
