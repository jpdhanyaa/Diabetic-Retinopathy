<style>
        body {
            background-color: theme('colors.background');
            color: theme('colors.on-background');
        }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-center p-margin-mobile md:p-margin-desktop bg-surface-container-low">
<main class="w-full max-w-md bg-surface-container-lowest border border-outline-variant rounded-xl p-8 relative overflow-hidden">
<div class="text-center mb-8">
<h1 class="font-headline-lg text-headline-lg text-primary mb-2 hidden md:block">RetinaScan AI</h1>
<h1 class="font-headline-lg-mobile text-headline-lg-mobile text-primary mb-2 md:hidden">RetinaScan AI</h1>
<h2 class="font-headline-md text-headline-md text-on-surface mb-2">Password Recovery</h2>
<p class="font-body-md text-body-md text-on-surface-variant">
                Enter the email address associated with your secure clinical portal account to receive a reset link.
            </p>
</div>
<form class="space-y-6" id="recovery-form" onsubmit="event.preventDefault(); showSuccess();">
<div>
<label class="block font-label-md text-label-md text-on-surface mb-1" for="email">Clinical Email Address</label>
<div class="relative">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">mail</span>
<input class="w-full pl-10 pr-4 py-3 bg-surface border border-outline-variant rounded-lg focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary font-body-md text-body-md text-on-surface" id="email" placeholder="doctor@hospital.edu" required="" type="email"/>
</div>
</div>
<button class="w-full bg-primary text-on-primary py-3 px-4 rounded-lg font-label-md text-label-md hover:bg-primary-container hover:text-on-primary-container transition-colors duration-200 flex items-center justify-center gap-2" type="submit">
<span class="material-symbols-outlined" data-weight="fill" style="font-variation-settings: 'FILL' 1;">enhanced_encryption</span>
                Send Secure Link
            </button>
</form>
<div class="hidden text-center space-y-4 py-4" id="success-state">
<div class="inline-flex items-center justify-center w-16 h-16 bg-surface-container-high rounded-full mb-4">
<span class="material-symbols-outlined text-3xl text-secondary" style="font-variation-settings: 'FILL' 1;">check_circle</span>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface">Secure Link Sent</h3>
<p class="font-body-md text-body-md text-on-surface-variant">
                If an account exists for that email, a secure reset link has been sent. The link will expire in 15 minutes for HIPAA compliance.
            </p>
</div>
<div class="mt-8 text-center">
<a class="inline-flex items-center gap-2 font-label-md text-label-md text-primary hover:text-primary-container transition-colors" href="#">
<span class="material-symbols-outlined text-sm">arrow_back</span>
                Back to Secure Login
            </a>
</div>
<div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-primary to-secondary"></div>
</main>
<footer class="mt-8 text-center">
<p class="font-label-md text-label-md text-on-surface-variant">© 2024 RetinaScan AI. HIPAA Compliant.</p>
</footer>
<script>
        function showSuccess() {
            document.getElementById('recovery-form').classList.add('hidden');
            document.getElementById('success-state').classList.remove('hidden');
        }
    </script>
</body></html>
